# Copy this file to build/.notarize.env (which is gitignored) and fill in your values.
#
#   cp build/.notarize.env.example build/.notarize.env
#
# Create an app-specific password at:
#   https://appleid.apple.com  ->  Sign-In & Security  ->  App-Specific Passwords
#
# APPLE_ID                    = the email of your Apple Developer account
# APPLE_APP_SPECIFIC_PASSWORD = the app-specific password you created (format xxxx-xxxx-xxxx-xxxx)
#
# Note: the Team ID is configured in package.json (build.mac.notarize.teamId =
# FLG4M553XP), so it does NOT need to be set here.

APPLE_ID="your-apple-id@example.com"
APPLE_APP_SPECIFIC_PASSWORD="xxxx-xxxx-xxxx-xxxx"
