# Copy this file to build/.notarize.env (which is gitignored) and fill in your values.
#
#   cp build/.notarize.env.example build/.notarize.env
#
# We notarize with an App Store Connect API key (same Apple account/approach as
# the sibling DM-Voice project). Create/download the .p8 key at:
#   App Store Connect -> Users and Access -> Integrations -> Keys -> (+)
# Give it the "Developer" role. You can only download the .p8 once.
#
# APPLE_API_KEY    = absolute path to your AuthKey_XXXXXXXXXX.p8 file on this machine
# APPLE_API_KEY_ID = the Key ID (the XXXXXXXXXX part of the filename)
# APPLE_API_ISSUER = the Issuer ID (a UUID shown at the top of the Keys page)
#
# No Team ID is needed for notarization with an API key — the key + issuer identify
# the team. (Code signing still uses the Developer ID cert in your keychain.)
#
# IMPORTANT: do NOT set APPLE_ID or APPLE_APP_SPECIFIC_PASSWORD here. If they are
# present, electron-builder uses the (failing) password path instead of the API key.
# Tip: store the .p8 outside the repo (e.g. ~/private_keys/) or in build/ — build/*.p8
# is gitignored so it is never committed.

APPLE_API_KEY="/Users/thomas/private_keys/AuthKey_XXXXXXXXXX.p8"
APPLE_API_KEY_ID="XXXXXXXXXX"
APPLE_API_ISSUER="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
